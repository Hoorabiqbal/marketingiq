# Copy to .env for local development (never commit .env). Nothing here is a secret and nothing is
# required: every setting has a default. The app uses no cloud LLM and needs no API key.

# The local planner: a llama-server running the fine-tuned Q4_K_M GGUF (started separately, kept running).
# MARKETINGIQ_LLAMA_URL=http://127.0.0.1:8089
# Per-request deadline in seconds for the planning call (default 8):
# MARKETINGIQ_LLAMA_TIMEOUT_S=8
# Folder with the prompt contract and export/marketingiq_runtime.json (default ../experiments/tiny_model):
# MARKETINGIQ_TINY_MODEL_DIR=

# Browser origins allowed to call the API, comma-separated ("*" = any). Pages served from
# localhost / 127.0.0.1 are always allowed. Default: the deployed Netlify frontend.
# CORS_ALLOW_ORIGINS=https://marketingiqp.netlify.app
# Data backend: duckdb (default) or pandas; and the CSV location (default ../data/...):
# MARKETINGIQ_DATA_BACKEND=duckdb
# MARKETINGIQ_CSV_PATH=
