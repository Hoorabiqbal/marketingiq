# Copy to .env for local development (never commit .env). On Render, set these under
# Environment instead. Only the Gemini key is required; everything else has a default.

# --- Required: at least one Gemini key --------------------------------------------------
# Either one key...
GEMINI_API_KEY=
# ...or numbered keys for automatic fallback (used instead of GEMINI_API_KEY when set):
# GEMINI_API_KEY_1=
# GEMINI_API_KEY_2=

# --- Optional ---------------------------------------------------------------------------
# Explanation provider for LLM_REQUIRED questions: gemini (default) or groq. No failover.
# LLM_PROVIDER=gemini
# Needed only when LLM_PROVIDER=groq:
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-20b
# Per-explanation deadline in seconds (default 25):
# LLM_TIMEOUT_SECONDS=25
# Most requests allowed to wait on an LLM at once; extra ones get an immediate "busy" answer
# so database answers keep a free worker (default 20; the server has 40 worker threads):
# LLM_MAX_CONCURRENT=20
# Whole-request deadline for the /api/chat Gemini tool-use fallback (default 45):
# CHAT_FALLBACK_TIMEOUT_SECONDS=45
# Set to 0 to send every chat question to the Gemini tool-use loop (rollback switch):
# CHAT_ROUTER_ENABLED=1
# Browser origins allowed to call the API, comma-separated ("*" = any). Pages served from
# localhost / 127.0.0.1 are always allowed. Default: the deployed Netlify frontend.
# CORS_ALLOW_ORIGINS=https://marketingiqp.netlify.app
# Data backend: duckdb (default) or pandas; and the CSV location (default ../data/...):
# MARKETINGIQ_DATA_BACKEND=duckdb
# MARKETINGIQ_CSV_PATH=
