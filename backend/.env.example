# Copy to .env for local development (never commit .env). On Render, set these under
# Environment instead. Only the Groq key is required; everything else has a default.

# --- Required ---------------------------------------------------------------------------
# Groq API key (https://console.groq.com/keys). Without it the app still starts and answers
# database questions; AI explanations report the service as unavailable.
GROQ_API_KEY=

# --- Optional ---------------------------------------------------------------------------
# Groq model for explanations (default openai/gpt-oss-120b):
# GROQ_MODEL=openai/gpt-oss-120b
# Per-explanation deadline in seconds (default 25):
# LLM_TIMEOUT_SECONDS=25
# Most explanations allowed to wait on Groq at once; extra ones get an immediate "busy" answer
# so database answers keep a free worker (default 20; the server has 40 worker threads):
# LLM_MAX_CONCURRENT=20
# Browser origins allowed to call the API, comma-separated ("*" = any). Pages served from
# localhost / 127.0.0.1 are always allowed. Default: the deployed Netlify frontend.
# CORS_ALLOW_ORIGINS=https://marketingiqp.netlify.app
# Data backend: duckdb (default) or pandas; and the CSV location (default ../data/...):
# MARKETINGIQ_DATA_BACKEND=duckdb
# MARKETINGIQ_CSV_PATH=
